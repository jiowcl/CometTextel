<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <Company>Inwazy Technology</Company>
    <Copyright>Ji-Feng Tsai</Copyright>
    <Description>.NET 8/9/10 x64 wrapper for CometTextel (win-x64 + linux-x64 native RID assets): GSM SMS over serial via P/Invoke C ABI — send, list, delete, and PDU helpers.</Description>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <PackageId>CometTextel.NET</PackageId>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <RepositoryUrl>https://github.com/jiowcl/CometTextel</RepositoryUrl>
    <PackageReleaseNotes>1.6.0: Adds SMS-STATUS-REPORT decoding, C ABI v2 with legacy DLL compatibility checks, and SDK support; ships win-x64 and linux-x64 RID natives. TFMs are net8.0/net9.0/net10.0.</PackageReleaseNotes>
    <PackageTags>comettextel;sms;gsm;pdu;modem;serial;pinvoke;windows;linux;x64</PackageTags>
    <Authors>Jiowcl</Authors>
    <PackageProjectUrl>https://github.com/jiowcl/CometTextel</PackageProjectUrl>
    <Platforms>AnyCPU;x64</Platforms>
    <Version>1.6.0</Version>
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>CometTextel.NET</RootNamespace>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <Optimize>true</Optimize>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <Optimize>true</Optimize>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\LICENSE" Link="LICENSE">
      <Pack>True</Pack>
      <PackagePath></PackagePath>
    </None>
    <None Include="..\README.md" Link="README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <!-- win-x64: pack RID asset; also copy next to output for ProjectReference / tests on Windows. -->
  <ItemGroup>
    <None Include="Lib\win-x64\comettextel.dll" Condition="Exists('Lib\win-x64\comettextel.dll')" Pack="true" PackagePath="runtimes/win-x64/native/comettextel.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>comettextel.dll</TargetPath>
      <Link>comettextel.dll</Link>
    </None>
    <!-- Backward-compatible path used by older scripts; prefer Lib/win-x64. -->
    <None Include="Lib\comettextel.dll" Condition="!Exists('Lib\win-x64\comettextel.dll') And Exists('Lib\comettextel.dll')" Pack="true" PackagePath="runtimes/win-x64/native/comettextel.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>comettextel.dll</TargetPath>
      <Link>comettextel.dll</Link>
    </None>
    <None Include="Lib\linux-x64\libcomettextel.so" Condition="Exists('Lib\linux-x64\libcomettextel.so')" Pack="true" PackagePath="runtimes/linux-x64/native/libcomettextel.so" />
  </ItemGroup>

  <Target Name="EnsureNativeDll" BeforeTargets="GenerateNuspec;Pack">
    <PropertyGroup>
      <_WinDll Condition="Exists('$(MSBuildProjectDirectory)\Lib\win-x64\comettextel.dll')">$(MSBuildProjectDirectory)\Lib\win-x64\comettextel.dll</_WinDll>
      <_WinDll Condition="'$(_WinDll)' == '' And Exists('$(MSBuildProjectDirectory)\Lib\comettextel.dll')">$(MSBuildProjectDirectory)\Lib\comettextel.dll</_WinDll>
      <_LinuxSo>$(MSBuildProjectDirectory)\Lib\linux-x64\libcomettextel.so</_LinuxSo>
    </PropertyGroup>
    <Error Condition="'$(_WinDll)' == ''" Text="Missing win-x64 native. Place comettextel.dll in Lib\win-x64\ (or Lib\) via pack.ps1 / CI before packing." />
    <Error Condition="'$(CometTextelRequireLinuxNative)' == 'true' And !Exists('$(_LinuxSo)')" Text="Missing linux-x64 native. Place libcomettextel.so in Lib\linux-x64\ before packing (set by CI pack-nuget job)." />
    <Warning Condition="!Exists('$(_LinuxSo)')" Text="Packing without Lib\linux-x64\libcomettextel.so — nupkg will be win-x64 only. Full CI sets CometTextelRequireLinuxNative=true." />
  </Target>

</Project>
